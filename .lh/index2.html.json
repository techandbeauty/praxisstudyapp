            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Praxis - Your personal study session, guided by intelligene </title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --primary: #1d1d1f;\n            --secondary: #86868b;\n            --background: #ffffff;\n            --accent: #0071e3;\n            --radius: 16px;\n        }\n\n        body {\n            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;\n            background-color: var(--background);\n            color: var(--primary);\n            line-height: 1.47059;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n            letter-spacing: -0.022em;\n        }\n\n        /* Hero Section - No top padding, video starts at very top */\n        .hero {\n            min-height: 60vh;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            padding: 0 0 60px;\n            position: relative;\n            overflow: hidden;\n            background: linear-gradient(180deg, #fafafa 0%, #f5f5f7 100%);\n        }\n\n        /* Video Container - Full width, no max-width constraint */\n        .video-container {\n            width: 100%;\n            height: auto;\n            aspect-ratio: 16 / 9;\n            margin-bottom: 48px;\n            position: relative;\n            opacity: 0;\n            animation: fadeInScale 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;\n        }\n\n        /* Video Circle - No corners, full width seamless */\n        .video-circle {\n            width: 100%;\n            height: 100%;\n            border-radius: 0;\n            overflow: hidden;\n            background: #fafafa;\n            position: relative;\n            border: none;\n        }\n\n        /* Video - Changed from 'cover' to 'contain' so AI presenter isn't cropped */\n        .video-circle video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n            background: #fafafa;\n        }\n\n        .mute-button {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            background: rgba(255, 255, 255, 0.8);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(0, 0, 0, 0.06);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            z-index: 10;\n            opacity: 0.7;\n        }\n\n        .mute-button:hover {\n            opacity: 1;\n            background: rgba(255, 255, 255, 0.95);\n        }\n\n        .mute-button svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--primary);\n        }\n\n        .video-error {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 100%;\n            padding: 40px;\n            text-align: center;\n            color: var(--secondary);\n        }\n\n        .video-error-icon {\n            font-size: 48px;\n            margin-bottom: 20px;\n        }\n\n        .video-error-title {\n            font-size: 17px;\n            margin-bottom: 10px;\n        }\n\n        .video-error-details {\n            font-size: 14px;\n            line-height: 1.5;\n        }\n\n        .video-error-code {\n            background: #f5f5f7;\n            padding: 4px 8px;\n            border-radius: 4px;\n            display: inline-block;\n            margin-top: 8px;\n            font-size: 13px;\n        }\n\n        .hero-content {\n            max-width: 980px;\n            text-align: center;\n            padding: 0 24px;\n        }\n\n        h1 {\n            font-size: clamp(48px, 8vw, 80px);\n            font-weight: 600;\n            margin-bottom: 20px;\n            letter-spacing: -0.015em;\n            opacity: 0;\n            animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;\n            line-height: 1.05;\n        }\n\n        .subheadline {\n            font-size: clamp(21px, 3vw, 28px);\n            color: var(--secondary);\n            font-weight: 400;\n            margin-bottom: 40px;\n            line-height: 1.4;\n            letter-spacing: -0.015em;\n            opacity: 0;\n            animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;\n        }\n\n        .cta-button {\n            display: inline-block;\n            background: var(--accent);\n            color: white;\n            padding: 18px 48px;\n            border-radius: 980px;\n            text-decoration: none;\n            font-weight: 400;\n            font-size: 19px;\n            letter-spacing: -0.01em;\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            border: none;\n            cursor: pointer;\n            opacity: 0;\n            animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;\n            box-shadow: 0 4px 12px rgba(0, 113, 227, 0.2);\n        }\n\n        .cta-button:hover {\n            transform: scale(1.02);\n            box-shadow: 0 8px 24px rgba(0, 113, 227, 0.3);\n        }\n\n        .cta-button:active {\n            transform: scale(0.98);\n        }\n\n        /* Content Section */\n        .content-section {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 140px 24px 160px;\n        }\n\n        .section-title {\n            font-size: clamp(40px, 5.5vw, 64px);\n            font-weight: 600;\n            text-align: center;\n            margin-bottom: 100px;\n            letter-spacing: -0.015em;\n            line-height: 1.05;\n        }\n\n        .features {\n            display: flex;\n            flex-direction: column;\n            gap: 100px;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .feature {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 80px;\n            align-items: center;\n            opacity: 0;\n            animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        .feature:nth-child(1) {\n            animation-delay: 0.1s;\n        }\n\n        .feature:nth-child(2) {\n            animation-delay: 0.25s;\n        }\n\n        .feature:nth-child(3) {\n            animation-delay: 0.4s;\n        }\n\n        /* Alternate layout - even features have mockup on right */\n        .feature:nth-child(even) .feature-mockup {\n            order: 2;\n        }\n\n        .feature:nth-child(even) .feature-content {\n            order: 1;\n        }\n\n        .feature-content {\n            text-align: left;\n        }\n\n        .feature-mockup {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n\n        .feature-mockup img {\n            width: 100%;\n            max-width: 320px;\n            height: auto;\n            filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.15));\n            transition: transform 0.3s ease;\n        }\n\n        .feature-mockup img:hover {\n            transform: translateY(-8px);\n        }\n\n        .feature-text {\n            font-size: 24px;\n            line-height: 1.47059;\n            color: var(--secondary);\n            letter-spacing: -0.015em;\n            font-weight: 400;\n        }\n\n        /* Footer */\n        footer {\n            padding: 100px 24px 48px;\n            text-align: center;\n            background: #f5f5f7;\n        }\n\n        .footer-content {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .footer-title {\n            font-size: 32px;\n            font-weight: 600;\n            margin-bottom: 8px;\n            letter-spacing: -0.015em;\n        }\n\n        .footer-text {\n            font-size: 17px;\n            color: var(--secondary);\n            letter-spacing: -0.01em;\n            font-weight: 400;\n        }\n\n        /* Modal */\n        .modal {\n            display: none;\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: rgba(0, 0, 0, 0.65);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            z-index: 1000;\n            align-items: center;\n            justify-content: center;\n            opacity: 0;\n            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n        }\n\n        .modal.active {\n            display: flex;\n            opacity: 1;\n        }\n\n        .modal-content {\n            background: white;\n            border-radius: 28px;\n            padding: 56px;\n            max-width: 540px;\n            width: 90%;\n            box-shadow: \n                0 60px 120px rgba(0, 0, 0, 0.25),\n                0 20px 40px rgba(0, 0, 0, 0.15);\n            transform: scale(0.96);\n            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n        }\n\n        .modal.active .modal-content {\n            transform: scale(1);\n        }\n\n        .modal-header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n\n        .modal-title {\n            font-size: 40px;\n            font-weight: 600;\n            margin-bottom: 12px;\n            letter-spacing: -0.015em;\n            line-height: 1.1;\n        }\n\n        .modal-subtitle {\n            font-size: 19px;\n            color: var(--secondary);\n            letter-spacing: -0.01em;\n            font-weight: 400;\n        }\n\n        .form-group {\n            margin-bottom: 20px;\n        }\n\n        .form-group label {\n            display: block;\n            font-size: 14px;\n            font-weight: 400;\n            margin-bottom: 8px;\n            letter-spacing: -0.01em;\n            color: var(--primary);\n        }\n\n        .form-group input {\n            width: 100%;\n            padding: 16px 18px;\n            border: 1px solid #d2d2d7;\n            border-radius: 12px;\n            font-size: 17px;\n            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;\n            transition: all 0.2s ease;\n            background: #fbfbfd;\n            letter-spacing: -0.01em;\n        }\n\n        .form-group input:focus {\n            outline: none;\n            border-color: var(--accent);\n            background: white;\n            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.1);\n        }\n\n        .submit-button {\n            width: 100%;\n            background: var(--accent);\n            color: white;\n            padding: 18px;\n            border: none;\n            border-radius: 12px;\n            font-size: 19px;\n            font-weight: 400;\n            cursor: pointer;\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;\n            letter-spacing: -0.01em;\n            margin-top: 8px;\n        }\n\n        .submit-button:hover {\n            transform: scale(1.01);\n            box-shadow: 0 8px 20px rgba(0, 113, 227, 0.25);\n        }\n\n        .close-modal {\n            position: absolute;\n            top: 28px;\n            right: 28px;\n            background: #f5f5f7;\n            border: none;\n            width: 36px;\n            height: 36px;\n            border-radius: 50%;\n            font-size: 22px;\n            cursor: pointer;\n            color: var(--secondary);\n            transition: all 0.2s ease;\n            line-height: 1;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .close-modal:hover {\n            background: #e8e8ed;\n            color: var(--primary);\n        }\n\n        .success-message {\n            display: none;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .success-message.active {\n            display: block;\n        }\n\n        .success-icon {\n            font-size: 56px;\n            margin-bottom: 20px;\n            color: #30d158;\n        }\n\n        .success-text {\n            font-size: 21px;\n            color: var(--secondary);\n            margin-bottom: 32px;\n            letter-spacing: -0.015em;\n        }\n\n        /* Animations */\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(40px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInScale {\n            from {\n                opacity: 0;\n                transform: scale(0.92);\n            }\n            to {\n                opacity: 1;\n                transform: scale(1);\n            }\n        }\n\n        /* Responsive */\n        @media (max-width: 1024px) {\n            .features {\n                gap: 80px;\n            }\n\n            .feature {\n                gap: 60px;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .hero {\n                min-height: 70vh;\n                padding: 0 0 40px;\n            }\n\n            .video-container {\n                margin-bottom: 32px;\n            }\n\n            .hero-content {\n                padding: 0 20px;\n            }\n\n            h1 {\n                font-size: 48px;\n            }\n\n            .subheadline {\n                font-size: 21px;\n                margin-bottom: 32px;\n            }\n\n            .content-section {\n                padding: 100px 20px 120px;\n            }\n\n            .section-title {\n                margin-bottom: 60px;\n            }\n\n            .features {\n                gap: 56px;\n            }\n\n            .feature {\n                grid-template-columns: 1fr;\n                gap: 32px;\n            }\n\n            /* On mobile, always show mockup first */\n            .feature:nth-child(even) .feature-mockup {\n                order: 1;\n            }\n\n            .feature:nth-child(even) .feature-content {\n                order: 2;\n            }\n\n            .feature-content {\n                text-align: center;\n            }\n\n            .feature-mockup img {\n                max-width: 280px;\n            }\n\n            .feature-text {\n                font-size: 21px;\n            }\n\n            .modal-content {\n                padding: 40px 28px;\n            }\n\n            .modal-title {\n                font-size: 32px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero {\n                min-height: 80vh;\n            }\n\n            h1 {\n                font-size: 40px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Hero Section -->\n    <section class=\"hero\">\n        <div class=\"video-container\">\n            <div class=\"video-circle\">\n                <video id=\"hero-video\" autoplay loop muted playsinline webkit-playsinline x-webkit-airplay=\"allow\">\n                    <!-- Video will be loaded from Cloudinary based on date -->\n                </video>\n                \n                <!-- Mute/Unmute Button -->\n                <button class=\"mute-button\" id=\"muteBtn\" aria-label=\"Toggle mute\">\n                    <!-- Muted Icon (default) -->\n                    <svg id=\"mutedIcon\" viewBox=\"0 0 24 24\">\n                        <path d=\"M3.63 3.63a.996.996 0 000 1.41L7.29 8.7 7 9H4c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1h3l3.29 3.29c.63.63 1.71.18 1.71-.71v-4.17l4.18 4.18c-.49.37-1.02.68-1.6.91-.36.15-.58.53-.58.92 0 .72.73 1.18 1.39.91.8-.33 1.55-.77 2.22-1.31l1.34 1.34a.996.996 0 101.41-1.41L5.05 3.63c-.39-.39-1.02-.39-1.42 0zM19 12c0 .82-.15 1.61-.41 2.34l1.53 1.53c.56-1.17.88-2.48.88-3.87 0-3.83-2.4-7.11-5.78-8.4-.59-.23-1.22.23-1.22.86v.19c0 .38.25.71.61.85C17.18 6.54 19 9.06 19 12zm-8.71-6.29l-.17.17L12 7.76V6.41c0-.89-1.08-1.33-1.71-.7zM16.5 12A4.5 4.5 0 0014 7.97v1.79l2.48 2.48c.01-.08.02-.16.02-.24z\"/>\n                    </svg>\n                    <!-- Unmuted Icon (hidden) -->\n                    <svg id=\"unmutedIcon\" style=\"display: none;\" viewBox=\"0 0 24 24\">\n                        <path d=\"M3 10v4c0 .55.45 1 1 1h3l3.29 3.29c.63.63 1.71.18 1.71-.71V6.41c0-.89-1.08-1.34-1.71-.71L7 9H4c-.55 0-1 .45-1 1zm13.5 2A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 4.45v.2c0 .38.25.71.6.85C17.18 6.53 19 9.06 19 12s-1.82 5.47-4.4 6.5c-.36.14-.6.47-.6.85v.2c0 .63.63 1.07 1.21.85C18.6 19.11 21 15.84 21 12s-2.4-7.11-5.79-8.4c-.58-.23-1.21.22-1.21.85z\"/>\n                    </svg>\n                </button>\n            </div>\n        </div>\n        <div class=\"hero-content\">\n            <h1>Praxis</h1>\n            <p class=\"subheadline\">Your personal study session, guided by intelligence.</p>\n            <button class=\"cta-button\" onclick=\"openModal()\">Become an App Tester</button>\n        </div>\n    </section>\n\n    <!-- Content Section -->\n    <section class=\"content-section\">\n        <h2 class=\"section-title\">Why Praxis works</h2>\n        <div class=\"features\">\n            <!-- Feature 1 -->\n            <div class=\"feature\">\n                <div class=\"feature-mockup\">\n                    <!-- Will load from Cloudinary tag: praxis-feature-1 -->\n                    <img id=\"mockup-1\" src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 800'%3E%3Crect fill='%23f5f5f7' width='400' height='800'/%3E%3Ctext x='200' y='400' font-family='system-ui' font-size='48' fill='%23666' text-anchor='middle'%3EPraxis%3C/text%3E%3Ctext x='200' y='450' font-family='system-ui' font-size='18' fill='%23999' text-anchor='middle'%3EMockup Coming Soon%3C/text%3E%3C/svg%3E\" alt=\"Praxis App - Study Feed\" />\n                </div>\n                <div class=\"feature-content\">\n                    <p class=\"feature-text\">Deep focus sessions that adapt to how you learn best, eliminating distractions and maximizing retention.</p>\n                </div>\n            </div>\n\n            <!-- Feature 2 -->\n            <div class=\"feature\">\n                <div class=\"feature-mockup\">\n                    <!-- Will load from Cloudinary tag: praxis-feature-2 -->\n                    <img id=\"mockup-2\" src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 800'%3E%3Crect fill='%23f5f5f7' width='400' height='800'/%3E%3Ctext x='200' y='400' font-family='system-ui' font-size='48' fill='%23666' text-anchor='middle'%3EPraxis%3C/text%3E%3Ctext x='200' y='450' font-family='system-ui' font-size='18' fill='%23999' text-anchor='middle'%3EMockup Coming Soon%3C/text%3E%3C/svg%3E\" alt=\"Praxis App - Focus Mode\" />\n                </div>\n                <div class=\"feature-content\">\n                    <p class=\"feature-text\">Intelligent guidance that understands your progress and adjusts difficulty in real-time.</p>\n                </div>\n            </div>\n\n            <!-- Feature 3 -->\n            <div class=\"feature\">\n                <div class=\"feature-mockup\">\n                    <!-- Will load from Cloudinary tag: praxis-feature-3 -->\n                    <img id=\"mockup-3\" src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 800'%3E%3Crect fill='%23f5f5f7' width='400' height='800'/%3E%3Ctext x='200' y='400' font-family='system-ui' font-size='48' fill='%23666' text-anchor='middle'%3EPraxis%3C/text%3E%3Ctext x='200' y='450' font-family='system-ui' font-size='18' fill='%23999' text-anchor='middle'%3EMockup Coming Soon%3C/text%3E%3C/svg%3E\" alt=\"Praxis App - Progress Tracking\" />\n                </div>\n                <div class=\"feature-content\">\n                    <p class=\"feature-text\">Built by students, for students—tested in real study sessions, refined by actual learning needs.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer>\n        <div class=\"footer-content\">\n            <div class=\"footer-title\">Praxis Study App | 2026 </div>\n            <div class=\"footer-text\">Now Availble for iOS Testers.</div>\n        </div>\n    </footer>\n\n    <!-- Modal -->\n    <div id=\"signup-modal\" class=\"modal\">\n        <div class=\"modal-content\">\n            <button class=\"close-modal\" onclick=\"closeModal()\">&times;</button>\n            <div class=\"modal-header\">\n                <h3 class=\"modal-title\">Start a Study Session</h3>\n                <p class=\"modal-subtitle\">Be among the first to experience Praxis and see all of the study features.</p>\n            </div>\n            <form id=\"signup-form\" action=\"https://formspree.io/f/xojnezyw\" method=\"POST\">\n                <div class=\"form-group\">\n                    <label for=\"name\">Name</label>\n                    <input type=\"text\" id=\"name\" name=\"name\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"email\">Email</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" required>\n                </div>\n                <button type=\"submit\" class=\"submit-button\">Request Access</button>\n            </form>\n            <div class=\"success-message\">\n                <div class=\"success-icon\">✓</div>\n                <p class=\"success-text\">Thank you! You will recieve an email soon for download.</p>\n                <button class=\"cta-button\" onclick=\"closeModal()\">Close</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // ============================================\n        // CLOUDINARY CONFIGURATION\n        // ============================================\n        /* =====================================================\n           CLOUDINARY SETUP FOR PRAXIS:\n           \n           1. Your Cloudinary Cloud Name: didqb05ko\n           \n           2. Enable Resource List access:\n              - Go to Cloudinary Settings → Security\n              - Under \"Restricted image types\" → UNCHECK \"Resource list\"\n              - Click Save\n           \n           3. Upload your THREE videos to Cloudinary and tag them:\n              \n              Before Feb 14, 2026:\n              - Upload your HeyGen AI video\n              - Tag it with: praxis-pre-launch\n              \n              Feb 14, 2026 (Launch Day):\n              - Upload your launch video\n              - Tag it with: praxis-launch\n              \n              After Feb 15, 2026 (Post-Launch):\n              - Upload your post-launch video\n              - Tag it with: praxis-post-launch\n           \n           4. Upload your THREE app mockup images and tag them:\n              - First mockup (deep focus) → Tag: praxis-feature-1\n              - Second mockup (intelligence) → Tag: praxis-feature-2\n              - Third mockup (built by students) → Tag: praxis-feature-3\n           \n           5. The page will automatically show the correct video and mockups!\n           \n           How it works:\n           - Same proven system as meishavernell.com\n           - Videos and images hosted on Cloudinary (fast, reliable)\n           - Automatic date-based video switching\n           - Tag-based mockup loading\n           - Works in Safari, Chrome, Firefox, all browsers\n           ===================================================== */\n        \n        const CLOUDINARY_CLOUD_NAME = 'didqb05ko';\n        const CLOUDINARY_TAGS = {\n            preLaunch: 'praxis-pre-launch',   // Before Feb 14, 2026\n            launch: 'praxis-launch',          // Feb 14, 2026\n            postLaunch: 'praxis-post-launch'  // Feb 15, 2026 and after\n        };\n\n        // Feature mockup tags\n        const MOCKUP_TAGS = {\n            feature1: 'praxis-feature-1',\n            feature2: 'praxis-feature-2',\n            feature3: 'praxis-feature-3'\n        };\n\n        // Fallback video if Cloudinary isn't set up yet\n        const FALLBACK_VIDEO = 'https://assets.mixkit.co/videos/preview/mixkit-slow-motion-of-a-person-using-a-tablet-34302-large.mp4';\n\n        // ============================================\n        // DATE-BASED VIDEO SELECTION\n        // ============================================\n        function getCurrentVideoTag() {\n            const today = new Date();\n            const launchDate = new Date('2026-02-14');\n            const postLaunchDate = new Date('2026-02-15');\n            \n            let tag, label;\n            \n            if (today < launchDate) {\n                tag = CLOUDINARY_TAGS.preLaunch;\n                label = 'Pre-launch (HeyGen AI video)';\n            } else if (today >= launchDate && today < postLaunchDate) {\n                tag = CLOUDINARY_TAGS.launch;\n                label = 'Launch day video';\n            } else {\n                tag = CLOUDINARY_TAGS.postLaunch;\n                label = 'Post-launch video';\n            }\n            \n            console.log('=== PRAXIS VIDEO SELECTOR ===');\n            console.log('Current date:', today.toLocaleDateString());\n            console.log('Active video:', label);\n            console.log('Cloudinary tag:', tag);\n            console.log('===========================');\n            \n            return { tag, label };\n        }\n\n        // ============================================\n        // LOAD VIDEO FROM CLOUDINARY\n        // ============================================\n        async function loadVideoFromCloudinary() {\n            const videoElement = document.getElementById('hero-video');\n            const videoCircle = document.querySelector('.video-circle');\n            const { tag, label } = getCurrentVideoTag();\n            \n            try {\n                console.log('Fetching video from Cloudinary with tag:', tag);\n                \n                const response = await fetch(\n                    `https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/video/list/${tag}.json?_=${Date.now()}`\n                );\n\n                if (response.ok) {\n                    const data = await response.json();\n                    \n                    if (data.resources && data.resources.length > 0) {\n                        const video = data.resources[0];\n                        const videoUrl = `https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/video/upload/q_auto/${video.public_id}.${video.format}`;\n                        \n                        console.log('✅ Video found:', video.public_id);\n                        console.log('📹 Video URL:', videoUrl);\n                        \n                        // Set video source\n                        videoElement.src = videoUrl;\n                        videoElement.load();\n                        \n                        // Try to play\n                        videoElement.addEventListener('loadeddata', function() {\n                            console.log('✅ Video loaded successfully');\n                            videoElement.play().catch(err => {\n                                console.log('⚠️ Autoplay blocked (normal behavior):', err.message);\n                                console.log('💡 Video will play on first user interaction');\n                            });\n                        }, { once: true });\n                        \n                    } else {\n                        console.log('⚠️ No video found with tag:', tag);\n                        console.log('📝 Make sure you:');\n                        console.log('   1. Uploaded a video to Cloudinary');\n                        console.log('   2. Tagged it with:', tag);\n                        console.log('   3. Enabled \"Resource list\" in Settings → Security');\n                        console.log('');\n                        console.log('Using fallback video...');\n                        \n                        videoElement.src = FALLBACK_VIDEO;\n                        videoElement.load();\n                    }\n                } else {\n                    throw new Error('Cloudinary API error: ' + response.status);\n                }\n            } catch (error) {\n                console.error('❌ Error loading video:', error.message);\n                console.log('📝 Troubleshooting:');\n                console.log('   1. Check Cloudinary cloud name:', CLOUDINARY_CLOUD_NAME);\n                console.log('   2. Verify \"Resource list\" is UNCHECKED in Cloudinary Settings → Security');\n                console.log('   3. Make sure video is tagged with:', tag);\n                console.log('');\n                console.log('Using fallback video...');\n                \n                // Show error message in video circle\n                showVideoError(tag, error.message);\n            }\n        }\n\n        // ============================================\n        // ERROR DISPLAY\n        // ============================================\n        function showVideoError(tag, errorMessage) {\n            const videoCircle = document.querySelector('.video-circle');\n            videoCircle.innerHTML = `\n                <div class=\"video-error\">\n                    <div class=\"video-error-icon\">⚠️</div>\n                    <div class=\"video-error-title\">Video not found on Cloudinary</div>\n                    <div class=\"video-error-details\">\n                        Looking for tag:<br>\n                        <code class=\"video-error-code\">${tag}</code>\n                    </div>\n                    <div class=\"video-error-details\" style=\"margin-top: 16px; font-size: 13px; opacity: 0.7;\">\n                        Upload your video to Cloudinary and tag it<br>\n                        Check the browser console (F12) for setup instructions\n                    </div>\n                </div>\n            `;\n        }\n\n        // ============================================\n        // LOAD MOCKUP IMAGES FROM CLOUDINARY\n        // ============================================\n        async function loadMockupFromCloudinary(tag, imgElementId) {\n            const imgElement = document.getElementById(imgElementId);\n            \n            try {\n                console.log(`Fetching mockup from Cloudinary with tag: ${tag}`);\n                \n                const response = await fetch(\n                    `https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/image/list/${tag}.json?_=${Date.now()}`\n                );\n\n                if (response.ok) {\n                    const data = await response.json();\n                    \n                    if (data.resources && data.resources.length > 0) {\n                        const image = data.resources[0];\n                        const imageUrl = `https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/image/upload/q_auto,f_auto/${image.public_id}.${image.format}`;\n                        \n                        console.log(`✅ Mockup found for ${tag}:`, image.public_id);\n                        imgElement.src = imageUrl;\n                    } else {\n                        console.log(`⚠️ No mockup found with tag: ${tag} - using Praxis logo placeholder`);\n                    }\n                } else {\n                    throw new Error('Cloudinary API error: ' + response.status);\n                }\n            } catch (error) {\n                console.error(`❌ Error loading mockup for ${tag}:`, error.message);\n                console.log('Using Praxis logo placeholder');\n            }\n        }\n\n        // ============================================\n        // LOAD ALL MOCKUPS\n        // ============================================\n        function loadAllMockups() {\n            loadMockupFromCloudinary(MOCKUP_TAGS.feature1, 'mockup-1');\n            loadMockupFromCloudinary(MOCKUP_TAGS.feature2, 'mockup-2');\n            loadMockupFromCloudinary(MOCKUP_TAGS.feature3, 'mockup-3');\n        }\n\n        // ============================================\n        // MUTE/UNMUTE FUNCTIONALITY\n        // ============================================\n        const muteBtn = document.getElementById('muteBtn');\n        const mutedIcon = document.getElementById('mutedIcon');\n        const unmutedIcon = document.getElementById('unmutedIcon');\n        const video = document.getElementById('hero-video');\n\n        muteBtn.addEventListener('click', () => {\n            if (video.muted) {\n                video.muted = false;\n                mutedIcon.style.display = 'none';\n                unmutedIcon.style.display = 'block';\n                console.log('🔊 Video unmuted');\n            } else {\n                video.muted = true;\n                mutedIcon.style.display = 'block';\n                unmutedIcon.style.display = 'none';\n                console.log('🔇 Video muted');\n            }\n        });\n\n        // ============================================\n        // INITIALIZE ON PAGE LOAD\n        // ============================================\n        window.addEventListener('load', () => {\n            loadVideoFromCloudinary();\n            loadAllMockups();\n        });\n\n        // Fallback: Play video on any user interaction (for Safari autoplay policy)\n        let hasInteracted = false;\n        document.addEventListener('click', function() {\n            if (!hasInteracted) {\n                hasInteracted = true;\n                const video = document.getElementById('hero-video');\n                if (video && video.paused) {\n                    video.play().catch(e => console.log('Play on click failed:', e.message));\n                }\n            }\n        }, { once: true });\n\n        // ============================================\n        // MODAL FUNCTIONALITY\n        // ============================================\n        const modal = document.getElementById('signup-modal');\n        const form = document.getElementById('signup-form');\n        const successMessage = document.querySelector('.success-message');\n\n        function openModal() {\n            modal.classList.add('active');\n            document.body.style.overflow = 'hidden';\n        }\n\n        function closeModal() {\n            modal.classList.remove('active');\n            document.body.style.overflow = 'auto';\n            form.style.display = 'block';\n            successMessage.classList.remove('active');\n            form.reset();\n        }\n\n        // Close on overlay click\n        modal.addEventListener('click', (e) => {\n            if (e.target === modal) {\n                closeModal();\n            }\n        });\n\n        // Handle form submission\n        form.addEventListener('submit', async (e) => {\n            e.preventDefault();\n            \n            const formData = new FormData(form);\n            \n            try {\n                const response = await fetch(form.action, {\n                    method: 'POST',\n                    body: formData,\n                    headers: {\n                        'Accept': 'application/json'\n                    }\n                });\n\n                if (response.ok) {\n                    form.style.display = 'none';\n                    successMessage.classList.add('active');\n                } else {\n                    alert('There was an issue submitting the form. Please try again.');\n                }\n            } catch (error) {\n                alert('There was an issue submitting the form. Please try again.');\n            }\n        });\n\n        // Escape key to close modal\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape' && modal.classList.contains('active')) {\n                closeModal();\n            }\n        });\n    </script>\n</body>\n</html>"
        }
    ]
}