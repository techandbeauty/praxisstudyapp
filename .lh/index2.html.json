                    "content": "Index: \n===================================================================\n--- \n+++ \n@@ -104,8 +104,40 @@\n             height: 20px;\n             fill: var(--primary);\n         }\n \n+        .replay-button {\n+            position: absolute;\n+            bottom: 50%;\n+            left: 50%;\n+            transform: translate(-50%, 50%);\n+            padding: 16px 32px;\n+            border-radius: 980px;\n+            background: var(--accent);\n+            color: white;\n+            border: none;\n+            cursor: pointer;\n+            display: flex;\n+            align-items: center;\n+            justify-content: center;\n+            font-size: 17px;\n+            font-weight: 400;\n+            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;\n+            letter-spacing: -0.01em;\n+            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n+            box-shadow: 0 8px 24px rgba(0, 113, 227, 0.3);\n+            z-index: 15;\n+        }\n+\n+        .replay-button:hover {\n+            transform: translate(-50%, 50%) scale(1.05);\n+            box-shadow: 0 12px 32px rgba(0, 113, 227, 0.4);\n+        }\n+\n+        .replay-button:active {\n+            transform: translate(-50%, 50%) scale(0.98);\n+        }\n+\n         .video-error {\n             display: flex;\n             flex-direction: column;\n             align-items: center;\n@@ -576,17 +608,28 @@\n \n             h1 {\n                 font-size: 40px;\n             }\n+\n+            .replay-button {\n+                font-size: 15px;\n+                padding: 14px 24px;\n+            }\n+\n+            .replay-button svg {\n+                width: 20px;\n+                height: 20px;\n+                margin-right: 6px;\n+            }\n         }\n     </style>\n </head>\n <body>\n     <!-- Hero Section -->\n     <section class=\"hero\">\n         <div class=\"video-container\">\n             <div class=\"video-circle\">\n-                <video id=\"hero-video\" autoplay loop muted playsinline webkit-playsinline x-webkit-airplay=\"allow\">\n+                <video id=\"hero-video\" autoplay muted playsinline webkit-playsinline x-webkit-airplay=\"allow\">\n                     <!-- Video will be loaded from Cloudinary based on date -->\n                 </video>\n                 \n                 <!-- Mute/Unmute Button -->\n@@ -599,8 +642,16 @@\n                     <svg id=\"unmutedIcon\" style=\"display: none;\" viewBox=\"0 0 24 24\">\n                         <path d=\"M3 10v4c0 .55.45 1 1 1h3l3.29 3.29c.63.63 1.71.18 1.71-.71V6.41c0-.89-1.08-1.34-1.71-.71L7 9H4c-.55 0-1 .45-1 1zm13.5 2A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 4.45v.2c0 .38.25.71.6.85C17.18 6.53 19 9.06 19 12s-1.82 5.47-4.4 6.5c-.36.14-.6.47-.6.85v.2c0 .63.63 1.07 1.21.85C18.6 19.11 21 15.84 21 12s-2.4-7.11-5.79-8.4c-.58-.23-1.21.22-1.21.85z\"/>\n                     </svg>\n                 </button>\n+\n+                <!-- Replay Button (hidden by default) -->\n+                <button class=\"replay-button\" id=\"replayBtn\" style=\"display: none;\" aria-label=\"Replay video\">\n+                    <svg viewBox=\"0 0 24 24\" style=\"width: 24px; height: 24px; fill: white; margin-right: 8px;\">\n+                        <path d=\"M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z\"/>\n+                    </svg>\n+                    <span>Listen to Tara Again</span>\n+                </button>\n             </div>\n         </div>\n         <div class=\"hero-content\">\n             <h1>Praxis</h1>\n@@ -910,8 +961,9 @@\n         const muteBtn = document.getElementById('muteBtn');\n         const mutedIcon = document.getElementById('mutedIcon');\n         const unmutedIcon = document.getElementById('unmutedIcon');\n         const video = document.getElementById('hero-video');\n+        const replayBtn = document.getElementById('